# Normalize all text files to LF, including Windows checkout.
* text=auto eol=lf

# Go source/module files.
*.go    text eol=lf diff=golang
go.mod  text eol=lf
go.sum  text eol=lf

# Common text files.
*.md    text eol=lf diff=markdown
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.sh    text eol=lf
Makefile text eol=lf

# Binaries.
*.exe binary
*.dll binary
*.so  binary

# GitHub Linguist - optional display/stat cleanup.
# Only keep this if testdata contains large fixtures or vendored snapshots.
testdata/** linguist-vendored

# Exclude dev/meta files from git archive exports.
/.github              export-ignore
/.claude              export-ignore
/.githooks            export-ignore
.gitattributes        export-ignore
.gitignore            export-ignore
.editorconfig         export-ignore
.golangci.yml         export-ignore
.pre-commit-config.yaml export-ignore
CLAUDE.md             export-ignore
